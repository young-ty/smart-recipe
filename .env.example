# 生成层（大模型）配置示例：复制成 .env 再按需填。
# .env / .env.local 已在 .gitignore 里，不会进版本库；部署时用系统环境变量覆盖。
#
# 这里**不是**服务端要配的 Key：服务端不预置额度，生成只认调用方自己带来的凭据
# （页面上的「我的模型 Key」，登录后可以存进账号）。下面这份只给本地工具用，
# 请求链路不读它（见 docs/项目设计方案.md 的 7.8）：
#   python -m tools.check_generator   凭据自检
#   python -m tools.draft_recipes     离线起草种子菜谱
RECIPE_GENERATOR_API_KEY=
RECIPE_GENERATOR_BASE_URL=https://api.deepseek.com/v1
# 模型 id 以服务端为准：python -m tools.check_generator --models 会列出这把 Key 能用的 id
RECIPE_GENERATOR_MODEL=deepseek-flash
# 单次生成的超时（秒），默认 20。模型变慢或换供应商时调它，不用改代码：
# 实测出一份完整菜谱 3~7 秒，设得过小（例如 6）会把正常生成误判成「生成服务不可用」。
RECIPE_GENERATOR_TIMEOUT_SECONDS=20

# 可选：生成结果是否写回菜谱库（默认 1 = 落库）。
# 落库后同名请求直接命中库内，不再消耗额度；设成 0 则只写 generated_recipes 缓存，
# 演示时可以每次都走生成分支。0 / false / no / off 都算关。
# RECIPE_PROMOTE_GENERATED=1

# 可选：日志与指标（默认就是下面这两行）。
# RECIPE_LOG_LEVEL=INFO
# text = 人类可读（带 [req=...]）；json = 一行一条，交给日志系统直接收
# RECIPE_LOG_FORMAT=text
# 同时在跑的推理数上限：本机（16 逻辑核）实测吞吐在并发 4 到顶，再往上只涨排队
# RECIPE_RECOGNIZE_MAX_CONCURRENCY=4

# 可选：推理跑在哪块硬件上（默认 auto = 有可用的加速就用，否则 CPU）。
# 也可以写 cpu / cuda / tensorrt，或逗号分隔的一串（顺序即优先级，CPU 永远兜底）。
# 装了 GPU 版 onnxruntime 不等于跑在 GPU 上：会话拿不到加速会打 WARNING，
# 真实结果在 GET /api/health 的 model.providers 里，例如 ["CUDAExecutionProvider", "CPUExecutionProvider"]。
# Windows 上还要装 backend/requirements-gpu.txt 里的运行库，缺一个就会静默回落 CPU。
# RECIPE_ONNX_PROVIDERS=auto

# 可选：启动时预热识别器（默认 1）。关掉的话 1 秒多的模型加载会落在第一个用户请求上。
# RECIPE_WARMUP=1

# 可选：模型目录与数据库位置（默认取仓库 models/ 与 backend/recipe.db）
# RECIPE_MODELS_DIR=
# RECIPE_DISH_ONNX_FILE=dish.onnx
# RECIPE_DB_FILE=
# RECIPE_DATABASE_URL=
